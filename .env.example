# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: use exclusively in trusted server code (webhooks, admin).
SUPABASE_SECRET_KEY=

# Search Console / Bing ownership via HTML tag (only the content="…" value). Optional if verified by DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# PostHog analytics (optional in development)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (Developers → API keys / Webhooks). Server only. Use sk_test_… until launch.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<dominio>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Local testing only (stripe-mock / fake server). Never set in production.
# STRIPE_API_BASE=http://localhost:12111

# Protects the daily job /api/cron/orders (Vercel sends it as a Bearer token).
CRON_SECRET=

# Notification emails through Resend (resend.com → API Keys). Without them no email is sent.
RESEND_API_KEY=
# Sender on your verified domain, e.g. "mercadito.baby <avisos@mercadito.baby>"
EMAIL_FROM=
# Local testing only (fake server). Never set in production.
# RESEND_API_BASE=http://127.0.0.1:12301

# Next stages (not used yet)
# OPENAI_API_KEY=
# SENTRY_DSN=
